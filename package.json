{
  "name": "verzus",
  "private": true,
  "description": "verzus: book a court, find a rival. Player app, venue dashboard, API and shared packages.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:start": "supabase start",
    "db:up": "node scripts/db-up.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/db-seed.mjs",
    "db:types": "pnpm --filter @verzus/db-types gen",
    "tunnel": "node scripts/tunnel.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "turbo": "^2.11.12",
    "typescript": "~6.0.3"
  }
}
