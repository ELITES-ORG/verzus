# Copy to .env.local. These are public values (shipped to the browser): never put a secret here.
# Local values come from `supabase status` (API URL, publishable key).
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8787
# "on" shows "Continue with Google" on the sign-in page. Needs Google enabled in Supabase
# (see [auth.external.google] in supabase/config.toml).
VITE_GOOGLE_SIGN_IN=
# Map style (tiles). Empty = OpenFreeMap Positron, recoloured to the verzus palette.
# Any MapLibre style URL works, e.g. a MapTiler style with your key.
VITE_MAP_STYLE_URL=
