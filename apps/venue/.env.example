# Copy to .env.local. These are public values (shipped to the browser): never put a secret here.
# Local values come from `supabase status` (API URL, publishable key).
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8787
# "on" shows "Continue with Google" on the sign-in page. Needs Google enabled in Supabase
# (see [auth.external.google] in supabase/config.toml).
VITE_GOOGLE_SIGN_IN=
# Map style (tiles). Empty = OpenFreeMap Positron, recoloured to the verzus palette.
# Any MapLibre style URL works, e.g. a MapTiler style with your key.
VITE_MAP_STYLE_URL=
# Geocoder for the location step: names the pin, and finds a place picked from the lists.
# Empty = OpenStreetMap's public Nominatim. Any Nominatim-compatible server's base URL works
# (the part before /reverse and /search).
VITE_GEOCODE_URL=
# Optional satellite photos on the location map ("Satellite" switch), so owners can place the pin on
# their actual building. An XYZ raster tile URL with {z}/{x}/{y}; unset = no switch. Needs a provider
# account; the key ships to browsers, so restrict it to your domains in the provider's dashboard.
#   MapTiler: https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_KEY
#   Esri (ArcGIS Location Platform): https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}?token=YOUR_KEY
VITE_SATELLITE_TILES=
# Credit line the provider requires, e.g. "© MapTiler © Maxar" or "Esri, Maxar, Earthstar Geographics".
VITE_SATELLITE_ATTRIBUTION=
