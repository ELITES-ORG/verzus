# Copy to .env for local development. Never commit .env.
PORT=8787
# Local Supabase (supabase start). Production: the pooler connection string from the Supabase dashboard.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
SUPABASE_URL=http://127.0.0.1:55421
# Publishable key (public, as in the apps): PUBLISHABLE_KEY from `supabase status`; production: the
# project's publishable key. Needed for sign-in with a username.
SUPABASE_PUBLISHABLE_KEY=
# Leave empty (local and production): the API verifies tokens with Supabase's public
# keys (JWKS). Set only for a project that still signs tokens with a legacy HS256 secret.
SUPABASE_JWT_SECRET=
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# 'fake' until the real provider is chosen.
PAYMENT_PROVIDER=fake
SENTRY_DSN=
